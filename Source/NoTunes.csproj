<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.1.0</Version>
        <Description>Native CLI for mirroring MP3 files to an iPhone music library.</Description>
        <AppConfig>app.config</AppConfig>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="ApplicationServices.cs" />
        <ProjectReference Include="Core/NoTunes.Core.csproj" />
        <ProjectReference Include="Platform.Windows/NoTunes.Platform.Windows.csproj" />
        <ProjectReference Include="Platform.Linux/NoTunes.Platform.Linux.csproj" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    </ItemGroup>

</Project>
